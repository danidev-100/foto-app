# ── App ──
APP_PORT=80

# ── Database (Neon) ──
# Obtener desde: https://console.neon.tech → tu proyecto → Connection String
DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/foto_app?sslmode=require

# ── JWT (generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))") ──
JWT_SECRET=changeme-jwt-secret-min-32-chars

# ── Mercado Pago ──
MP_ACCESS_TOKEN=your-mp-access-token
MP_SANDBOX=true
# Webhook secret para validar firma HMAC (configurar en dashboard MP -> Webhooks)
MP_WEBHOOK_SECRET=

# ── CORS (origen permitido para el frontend) ──
CORS_ORIGIN=http://localhost:80

# ── Frontend URL (para emails y back_urls de MP) ──
FRONTEND_URL=http://localhost:3000

# ── Login con Google (OAuth) ──
# Crear en Google Cloud Console → Credentials → OAuth Client ID (Web application)
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# ── Email (SMTP) — para "olvidaste tu contraseña" y notificaciones ──
# Gmail: activá verificación en 2 pasos → Contraseñas de aplicaciones
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=tu-app-password
EMAIL_FROM=tu-cuenta@gmail.com

# ── Bank Transfer Details (opcional, solo si se usa) ──
BANK_NAME=
BANK_CBU=
BANK_ALIAS=
BANK_HOLDER=
BANK_CUIT=

# Frontend — idle session timeout in milliseconds (default: 30 min)
VITE_IDLE_TIMEOUT=1800000
