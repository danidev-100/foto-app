# ── App ──
SERVER_PORT=3003

# ── Database (Neon) ──
DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/foto_app?sslmode=require

# ── JWT (generate: openssl rand -base64 32) ──
JWT_SECRET=changeme-jwt-secret

# ── Frontend URL (para back_urls de MP — poner URL real, ej: https://foto-app.vercel.app) ──
FRONTEND_URL=http://localhost:3003

# ── Mercado Pago ──
MP_ACCESS_TOKEN=APP_USR-5242432722103311-052111-ccd8c2d224b67c16a3ecf6c84b92a502-46330763
MP_SANDBOX=true

# ── Login con Google (OAuth) ──
# Crear en Google Cloud Console → Credentials → OAuth Client ID (Web application).
# Authorized JavaScript origins: http://localhost:3000 y https://tu-dominio.vercel.app
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# ── Email (SMTP) — para "olvidaste tu contraseña" y notificaciones ──
# Gmail: activá verificación en 2 pasos → Contraseñas de aplicaciones → 16 caracteres
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=tu-app-password
EMAIL_FROM=tu-cuenta@gmail.com

# ── Logging ──
LOG_LEVEL=info
